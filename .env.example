# Copy to .env (repo root). Both keys are free; see the key table in README.
# Optional: override the SQLite path (default: data/community.sqlite):
# COMMUNITY_DB=
# LLM generation (reports, comparisons, blind judging):
DEEPSEEK_API_KEY=
# Optional: unlocks Claude Opus 4.8 / Sonnet 5 in the sidebar model picker:
ANTHROPIC_API_KEY=
# Embeddings (needed for ingest + hybrid/vector retrieval; without it the
# app falls back to BM25 keyword retrieval over the committed data):
VOYAGE_API_KEY=
# Reddit ingest (--source reddit). Optional: without these the crawler
# falls back to public .json, which Reddit's Data API gate blocks on most
# networks. A free "script" app at reddit.com/prefs/apps gives you both:
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Reddit rejects generic User-Agents; identify yourself, e.g.
# "community-voices/0.1 by u/yourname":
REDDIT_USER_AGENT=
# X ingest (--source x). Required for that source: X API v2 recent search
# is not available on the free tier, so this needs a paid tier (Basic or
# above) from developer.x.com:
X_BEARER_TOKEN=
# Optional: the recent-search query the sidebar X source uses. Default is
# "#gaming -is:retweet -is:reply lang:en". The CLI takes it positionally.
X_QUERY=
