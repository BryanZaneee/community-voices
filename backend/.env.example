# Copy to backend/.env (or repo-root .env) and fill in what you have.
# Every value below is optional; the app degrades gracefully without keys.

# --- LLM providers ---
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# --- embeddings / live ingest ---
VOYAGE_API_KEY=

# --- ingest sources ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
X_BEARER_TOKEN=
X_QUERY=

# --- storage ---
# Path to the sqlite DB file; defaults to data/community.sqlite in the repo
COMMUNITY_DB=

# --- spend guards (see backend/app/budget.py) ---
# Daily cap on LLM calls (complete + judge_json combined); 0 disables
DAILY_LLM_CALL_CAP=40
# Daily cap on Voyage embedding API requests (one charge per batch); 0 disables
DAILY_EMBED_CALL_CAP=300
# Comma-separated model keys selectable on this deployment
ALLOWED_MODELS=deepseek-v4,deepseek-v4-flash
# Max /api/generate, /api/generate/stream, /api/compare hits per visitor
# IP per 10 minutes; 0 disables
GENERATE_PER_10MIN=3
# Bearer token required for POST /api/ingest/week and /api/ingest/source;
# unset leaves them open (local dev default)
ADMIN_TOKEN=
